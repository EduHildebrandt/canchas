# Configuración del Sistema de Reservas de Cancha de Fútbol 5

# URL y Claves de Supabase (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago Credenciales (Access Token de Producción o Sandbox de prueba)
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-if-applicable

# URL Base de la aplicación (utilizada para callbacks de Mercado Pago y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave de acceso al panel de administración (Mostrador / Backoffice)
ADMIN_PASSWORD=futbol5admin
